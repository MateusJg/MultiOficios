# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Security & Admin authentication (OBLIGATORIAS en producción / Hostinger)
# Cambie estos valores por secretos seguros y únicos antes de desplegar.
ADMIN_MASTER_PASSWORD="CambiarPorUnaContraseñaAdminMuySegura2026!"
ESCROW_SIGNING_SECRET="CambiarPorUnaClaveCriptograficaDeFirmaFiduciariaMuyLargaYSecreta"

# Configuración de inicialización de datos de prueba
# En producción debe ser 'false' para evitar sembrar colaboradores ficticios en Firestore.
VITE_SEED_MOCK_DATA="false"

